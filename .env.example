GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# SQLite works locally without installing a database server.
DB_TYPE=sqlite
SQLITE_DB_PATH=instance/reviseai.sqlite3

# To use MySQL instead, set DB_TYPE=mysql and configure:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=aiquizdb
